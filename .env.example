# Copy to .env; replace BOTH placeholders with independent random secrets.
# Optional HTTPS override: hostname only, no https:// or /HDoi path.
HDOI_DOMAIN=queue.example.com
# QUEUE_API_TOKEN must equal backend HDOI_TOKEN.
# BACKEND_WORKER_TOKEN must equal backend HDOI_WORKER_TOKEN.
QUEUE_API_TOKEN=REPLACE_WITH_RANDOM_QUEUE_SECRET
APP_NAMESPACE=hdoi-production
# Must be reachable from inside the containers; localhost refers to the container.
BACKEND_URL=https://backend.example.invalid
BACKEND_WORKER_TOKEN=REPLACE_WITH_RANDOM_BACKEND_SECRET
# Positive integers; application maximums: concurrency 16, reads/writes 50 each.
WORKER_CONCURRENCY=16
SHEETS_READS_PER_MINUTE=40
SHEETS_WRITES_PER_MINUTE=40
# Change only for a deliberate restore or a separate deployment.
REDIS_VOLUME_NAME=hdoi-redis-data
# Optional compact JSON. Keep empty if credentials are not needed by this app.
# Wrap populated JSON in single quotes in .env. Never commit actual credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Compose supplies REDIS_URL=redis://redis:6379 and PORT=3100 internally.
BUSINESS_DATA_PROVIDER=sheets
DATA_DONG_BO_URL=https://datadongbo.157.66.219.11.sslip.io
DATA_DONG_BO_TOKEN=
# Required by the durable Drive credential archive; shared by API and worker.
# Generate once, back up securely, and retain the same key across redeployments.
# See DRIVE_CREDENTIALS.md. Never replace a key used by an existing archive.
DRIVE_CREDENTIAL_ENCRYPTION_KEY=531be666b330ba4ed667844e9234ca1e730b9a61a82a09e598b1e4b0e6cb7f00
